<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SpeedKlava — твой ритм печати" Width="1320" Height="900" MinWidth="1000" MinHeight="720" Background="#101117" Foreground="#F1F1F7" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9699AC"/>
  <SolidColorBrush x:Key="Accent" Color="#B4A0FF"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E4E4F0"/><Setter Property="Background" Value="#262833"/><Setter Property="Padding" Value="17,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#C5B5FF"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#B4A0FF"/><Setter Property="Foreground" Value="#171225"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="16,13"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1A1C25"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#2A2C38"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="23"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E4E4F0"/><Setter Property="Margin" Value="0,9"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E2DDF2"/><Setter Property="Background" Value="#242431"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#403550"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#373047"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#DDD7EF"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="11,8"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#282634" BorderBrush="#464051" BorderThickness="1" CornerRadius="7"><DockPanel Margin="10,0"><TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="#BCAECA" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Margin="11,7,26,7" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#242431" BorderBrush="#494152" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3" Margin="0,5,0,0"><ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Background" Value="#30313F"/><Setter Property="Foreground" Value="#B4A0FF"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Background="#101117">
  <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#15161E" BorderBrush="#262832" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,29,18,22">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="9,0,0,7"><Border Background="#B4A0FF" CornerRadius="8" Padding="8,3"><TextBlock Text="S" FontSize="20" FontWeight="Bold" Foreground="#171225"/></Border><TextBlock Text="speedklava" FontSize="21" FontWeight="SemiBold" Margin="9,1,0,0"/></StackPanel>
     <TextBlock Text="МЕНЬШЕ УСИЛИЙ. БОЛЬШЕ ПОТОКА." FontSize="8" Foreground="#777B91" Margin="10,3,0,35"/>
     <TextBlock Text="ПРАКТИКА" Style="{StaticResource Label}" Margin="14,0,0,10"/>
     <Button x:Name="NavTrain" Content="⌨    Тренировка" Style="{StaticResource Nav}"/>
     <Button x:Name="NavLessons" Content="▦    Карта навыка" Style="{StaticResource Nav}"/>
     <Button x:Name="NavProgress" Content="↗    Мой прогресс" Style="{StaticResource Nav}"/>
     <TextBlock Text="ПОЛЕЗНОЕ" Style="{StaticResource Label}" Margin="14,30,0,10"/>
     <Button x:Name="NavScience" Content="◇    Как это работает" Style="{StaticResource Nav}"/>
     <Button x:Name="NavSettings" Content="⚙    Настройки" Style="{StaticResource Nav}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Border Background="#222030" CornerRadius="12" Padding="15" Margin="0,0,0,20"><StackPanel><TextBlock Text="Маленький шаг сегодня" Foreground="#D5C9FF" FontWeight="SemiBold"/><TextBlock Text="Вернись завтра. Навык растёт между занятиями." Foreground="#A39CB9" FontSize="12" Margin="0,7,0,0"/></StackPanel></Border>
     <TextBlock x:Name="LevelLabel" Text="Уровень 1 · Исследователь" FontWeight="SemiBold" FontSize="12"/>
     <ProgressBar x:Name="LevelBar" Margin="0,10,0,8" Maximum="500"/>
     <TextBlock x:Name="XpLabel" Text="0 / 500 XP" Style="{StaticResource Label}"/>
     <TextBlock Text="OFFLINE  /  WINDOWS  /  v1.0" FontSize="9" Foreground="#63677D" Margin="0,22,0,0"/>
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="34,29,34,30">
    <DockPanel Margin="0,0,0,25"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="РАСКЛАДКА" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="LanguageBox" Width="125" SelectedIndex="0"><ComboBoxItem Content="RU · ЙЦУКЕН"/><ComboBoxItem Content="EN · QWERTY"/></ComboBox></StackPanel><StackPanel><TextBlock x:Name="PageTitle" Text="Найди свой ритм." Style="{StaticResource Title}"/><TextBlock x:Name="PageSubtitle" Text="Точность сегодня. Скорость — следом." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
    <TextBlock x:Name="Notice" Foreground="#F5C77A" Visibility="Collapsed" Margin="0,0,0,15"/>
    <StackPanel x:Name="TrainPage">
     <UniformGrid Columns="3" Margin="0,0,0,20">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="ЛУЧШИЙ ТЕСТ" Style="{StaticResource Label}"/><TextBlock x:Name="BestStat" Text="— зн/мин" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Тесты отдельно от учебных повторов" Style="{StaticResource Label}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="ТОЧНОСТЬ ПРАКТИКИ" Style="{StaticResource Label}"/><TextBlock x:Name="AccuracyStat" Text="—" Foreground="#80D9B5" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="По последним 10 занятиям" Style="{StaticResource Label}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ТВОЯ РЕГУЛЯРНОСТЬ" Style="{StaticResource Label}"/><TextBlock x:Name="StreakStat" Text="Первый шаг" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Завершённые занятия по дням" Style="{StaticResource Label}"/></StackPanel></Border>
     </UniformGrid>
     <Border CornerRadius="15" Padding="24" Margin="0,0,0,20" BorderBrush="#49415F" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#322944" Offset="0"/><GradientStop Color="#202435" Offset="1"/></LinearGradientBrush></Border.Background><DockPanel><StackPanel DockPanel.Dock="Right" Width="188" Margin="25,0,0,0"><TextBlock x:Name="GoalLabel" Text="0 / 10 минут сегодня" Foreground="#D6CCED" HorizontalAlignment="Right"/><ProgressBar x:Name="GoalBar" Margin="0,12,0,8" Maximum="100"/><TextBlock Text="Считается время активной печати" Style="{StaticResource Label}" HorizontalAlignment="Right" TextAlignment="Right"/></StackPanel><StackPanel><TextBlock Text="ТВОЙ СЛЕДУЮЩИЙ ШАГ" Foreground="#B9A5E0" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="LessonTitle" Text="01 / Опора: два указательных" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,5"/><TextBlock x:Name="LessonHint" Text="Найди выступы на А и О. Остальные пальцы отдыхают на ФЫВА и ОЛДЖ." Foreground="#B9B5C9" FontSize="13"/></StackPanel></DockPanel></Border>
     <Border Style="{StaticResource Card}" Padding="25">
      <StackPanel>
       <DockPanel><ComboBox x:Name="ModeBox" DockPanel.Dock="Left" Width="172" SelectedIndex="0"><ComboBoxItem Content="Курс"/><ComboBoxItem Content="Слабые клавиши"/><ComboBoxItem Content="Сочетания"/><ComboBoxItem Content="Тексты"/><ComboBoxItem Content="Тест"/></ComboBox><ComboBox x:Name="DurationBox" DockPanel.Dock="Left" Margin="10,0,0,0" Width="108" SelectedIndex="1"><ComboBoxItem Content="30 секунд"/><ComboBoxItem Content="60 секунд"/><ComboBoxItem Content="120 секунд"/></ComboBox><TextBlock x:Name="RunStats" Text="ГОТОВ К ПРАКТИКЕ" Foreground="#A89CC6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
       <ProgressBar x:Name="RunBar" Maximum="100" Margin="0,20,0,18" Height="3"/>
       <Border x:Name="TypingSurface" Background="#14151D" CornerRadius="12" Padding="20" MinHeight="155" Focusable="True" Cursor="IBeam" AutomationProperties.Name="Текст для печати. Нажмите Начать, затем печатайте показанный текст.">
        <TextBlock x:Name="TypingText" FontFamily="Consolas" FontSize="25" LineHeight="39" TextWrapping="Wrap"/>
       </Border>
       <DockPanel Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PauseButton" Content="Пауза" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="StartButton" Content="Начать практику  →" Style="{StaticResource Primary}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Coach" Text="Не смотри на клавиатуру. Начни с удобного темпа." Foreground="#C4BED5" FontSize="12"/><TextBlock x:Name="FingerHint" Text="А → левый указательный" Foreground="#8D83A4" FontSize="11" Margin="0,4,12,0"/></StackPanel></DockPanel>
       <Border x:Name="ResultPanel" Visibility="Collapsed" Background="#262338" CornerRadius="10" Padding="18" Margin="0,18,0,0"><StackPanel><TextBlock x:Name="ResultTitle" Foreground="#D9CCFF" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ResultDetail" Foreground="#C1BBD4" Margin="0,9,0,0"/></StackPanel></Border>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16"><StackPanel><DockPanel Margin="0,0,0,15"><TextBlock Text="КАРТА ДВИЖЕНИЙ" Style="{StaticResource Label}"/><TextBlock Text="Один цвет — один палец  ·  яркая клавиша — следующая" Style="{StaticResource Label}" HorizontalAlignment="Right"/></DockPanel><StackPanel x:Name="KeyboardPanel" HorizontalAlignment="Center"/><TextBlock x:Name="KeyboardCaption" Text="Исходная позиция: Ф Ы В А  ·  О Л Д Ж. Большие пальцы — над пробелом." Style="{StaticResource Label}" TextAlignment="Center" Margin="0,13,0,0"/></StackPanel></Border>
     <TextBlock Text="Без гонки и штрафов за пропущенный день. Занимайся в своём темпе." Foreground="#777D92" FontSize="12" Margin="2,16,0,0"/>
    </StackPanel>
    <StackPanel x:Name="OtherPage" Visibility="Collapsed"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
